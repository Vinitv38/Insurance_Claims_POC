NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Azure Document Intelligence (for document-to-markdown conversion)
DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
DI_API_KEY=your-azure-di-api-key-here

# Agentic Studio (server-side only — never prefix with NEXT_PUBLIC_)
AGENTIC_STUDIO_PAT=na_your_personal_access_token
AGENT_WORKFLOW_LTC_NEW_URL=https://agenticstudio.synechron.com/api/http-execution/trigger/<ltc-new-workflow-id>
AGENT_WORKFLOW_STATUS_URL=https://agenticstudio.synechron.com/api/http-execution/execution/{executionId}
AGENT_WORKFLOW_POLL_INTERVAL_MS=2000
AGENT_WORKFLOW_MAX_WAIT_MS=180000
AGENT_WORKFLOW_REQUEST_TIMEOUT_MS=30000
